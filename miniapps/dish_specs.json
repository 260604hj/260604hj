{
  "meta": {
    "source": "food5_bowls.3dm, layer PolyFood (Rhino 8, Z-up)",
    "units": "1 unit = 1 cm (visual scale). Rhino doc is set to mm but values were modeled as cm.",
    "axes": "Rhino Z-up. three.js is Y-up: (x, y, z)_rhino -> (x, z, -y)_three",
    "frames": "Each setting has its origin at the placemat center. container.center is relative to the mat center. Topping coordinates are relative to container.center (XY) and absolute from mat top z=0 (Z).",
    "userStrings": "Every Rhino object has dish, role (Mat|Bowl|Base|Topping|Cutlery), ingredient, and optionally piece (shared ID for the parts of one piece)"
  },

  "shared": {
    "placemat": { "shape": "roundedSlab", "w": 52, "d": 38, "h": 0.6, "corner": 2.5, "topZ": 0, "color": "#705038", "gloss": 0.25, "name": "walnut_mat" },
    "brass": { "color": "#C4A462", "gloss": 0.8 },
    "cutleryLanes": { "note": "Placed on the right side of the mat, long axis along Y, head toward +Y. x is relative to the mat center", "laneA": 16.8, "laneB": 20.3, "chopsticks": 19.0 },
    "placementDefaults": {
      "gridCell": 0.15,
      "triesPerItem": 40,
      "contactTolerance": 0.01,
      "baseNestle": "Only the base (rice, sauce, soup) may be embedded: sink 0.06 into solid food, 0.12 into liquid. No other overlap is allowed"
    }
  },

  "primitives": {
    "ellipsoid":     { "params": ["a", "b", "c"], "note": "semi-axes x, y, z" },
    "roundedBox":    { "params": ["a", "b", "c", "sharpness"], "note": "Rhino used a sphere NURBS with edge weight=s and corner weight=s^2. On the web, approximate with a superellipsoid (exponent ~ 0.35-0.5)" },
    "clampedBlob":   { "params": ["a", "b", "c", "zMin", "zMax"], "note": "Ellipsoid with z clamped to flatten top/bottom (bun, patty, dollop)" },
    "leaf":          { "params": ["length", "width", "cup", "bend", "ruffle", "thickness"], "note": "Thin ellipsoid: u=x/a, taper=1-0.35u-0.5u^2 (y*=max(0.12,taper)), z += cup*yn^2 + bend*u^2 + ruffle*sin(3.2*pi*u+phase)*|yn|" },
    "hemisphere":    { "params": ["r", "zScale"], "note": "Flat face down; flipChance turns the cut face up" },
    "cylinder":      { "params": ["r", "h"] },
    "tube":          { "params": ["rOuter", "rInner", "length"], "note": "Lies along the Y axis (rigatoni)" },
    "vTube":         { "params": ["rOuter", "rInner", "h"], "note": "Standing (maki nori/rice)" },
    "torus":         { "params": ["R", "r"] },
    "crescent":      { "params": ["a", "b", "c", "curve"], "note": "Ellipsoid, y += curve*(x/a)^2 (avocado)" },
    "teardrop":      { "params": ["a", "b", "c"], "note": "y *= (1-0.35*x/a) (pumpkin seed)" },
    "wavyRibbon":    { "params": ["a", "b", "c", "amp", "freq"], "note": "z += amp*sin(freq*x) (smoked salmon)" },
    "droopSheet":    { "params": ["a", "b", "c", "droop"], "note": "Square sheet, z -= droop*((x/a)^4+(y/b)^4) (cheddar)" },
    "ruffledDisk":   { "params": ["R", "c", "amp", "lobes", "dish"], "note": "z += amp*sin(lobes*theta)*(r/R)^2 - dish*(r/R)^2 (burger lettuce)" },
    "triangleChip":  { "params": ["a", "b", "c"], "note": "y *= max(0.08, 1 - x/a), curl z += 0.12*(y/b)^2" },
    "spiralPipe":    { "params": ["turns", "r0", "r1", "pipeR"], "note": "Flat spiral pipe (soup cream swirl)" }
  },

